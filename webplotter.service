[Unit]
Description=Pen plotter printer web service
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
User=pi
WorkingDirectory=/home/pi/webplotter/server
ExecStart=/home/pi/webplotter/server/venv/bin/python /home/pi/webplotter/server/main.py
TimeoutSec=600
Restart=on-failure
RuntimeDirectoryMode=755
